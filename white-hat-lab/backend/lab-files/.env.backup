# SIMULATED .env BACKUP — White Hat Lab training environment.
# These values are FAKE placeholders. They authenticate to nothing.
#
# FINDING: environment file left in a web-reachable directory.
# This is one of the most common and most damaging misconfigurations.

APP_ENV=production
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_USER=lab_service_account
DB_PASSWORD=EXAMPLE-NOT-A-REAL-PASSWORD

API_KEY=EXAMPLE-FAKE-API-KEY-0000000000
JWT_SECRET=EXAMPLE-FAKE-JWT-SECRET-DO-NOT-USE

# REMEDIATION: keep secrets in a secret manager (Vault, AWS Secrets Manager,
# etc.), never commit or back up .env files into web-served paths, and rotate
# any credential that has ever been exposed.
